    {
      "id": "7b2e9f10-3c4d-4e5f-8a9b-0c1d2e3f4005",
      "name": "Format messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst alerts = body.alerts || [];\nconst scan = body.scan;\nconst esc = (s) =>\n  String(s ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\nconst ICON = { critical: \"🔴\", high: \"🟠\", medium: \"🟡\", low: \"🔵\", info: \"⚪\" };\nconst COLOR = { critical: \"#b8233a\", high: \"#b04a17\", medium: \"#8a6a00\", low: \"#1d4ed8\", info: \"#6b7280\" };\nconst n = alerts.length;\nconst highest = (body.highest || \"info\").toUpperCase();\nconst source = scan ? `scan #${scan.id} (${scan.profile}) of ${scan.target}` : \"CampusShield\";\n\n// ---- Telegram (HTML parse mode, max 10 alerts listed)\nconst head = body.test\n  ? \"🧪 <b>CampusShield test alert</b>\"\n  : `🛡️ <b>CampusShield: ${n} new alert${n === 1 ? \"\" : \"s\"}</b>`;\nconst lines = alerts\n  .slice(0, 10)\n  .map((a) => `${ICON[a.severity] || \"•\"} <b>${esc(a.severity.toUpperCase())}</b> ${esc(a.title)}`);\nif (n > 10) lines.push(`…and ${n - 10} more`);\nconst telegram = [head, `<i>${esc(source)}</i>`, \"\", ...lines, \"\", `Review: ${esc(body.alerts_url)}`]\n  .join(\"\\n\");\n\n// ---- Email (HTML)\nconst subject = body.test\n  ? \"[CampusShield] Test alert\"\n  : n === 1\n    ? `[CampusShield] ${highest}: ${alerts[0].title}`\n    : `[CampusShield] ${n} new alerts (highest: ${highest}) from ${source}`;\nconst rows = alerts\n  .map(\n    (a) => `<tr>\n  <td style=\"padding:10px 12px;border-bottom:1px solid #e5e7eb;vertical-align:top;white-space:nowrap\">\n    <span style=\"display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:600;color:${COLOR[a.severity] || \"#374151\"};background:#f3f4f6\">${esc(a.severity.toUpperCase())}</span>\n  </td>\n  <td style=\"padding:10px 12px;border-bottom:1px solid #e5e7eb\">\n    <div style=\"font-weight:600;color:#111827\">${esc(a.title)}</div>\n    <div style=\"color:#4b5563;font-size:13px;margin-top:2px\">${esc(a.message)}</div>\n    <div style=\"font-size:12px;margin-top:4px\"><a href=\"${esc(a.url)}\" style=\"color:#047857\">Open in CampusShield</a></div>\n  </td>\n</tr>`,\n  )\n  .join(\"\");\nconst html = `<div style=\"font-family:Segoe UI,Arial,sans-serif;max-width:680px;color:#111827\">\n  <div style=\"border-top:4px solid #059669;padding:16px 0 4px\">\n    <div style=\"font-size:18px;font-weight:700\">${body.test ? \"CampusShield test alert\" : `${n} new alert${n === 1 ? \"\" : \"s\"}`}</div>\n    <div style=\"color:#6b7280;font-size:13px\">${esc(source)}</div>\n  </div>\n  <table style=\"width:100%;border-collapse:collapse;margin-top:12px\">${rows}</table>\n  <p style=\"font-size:12px;color:#6b7280;margin-top:16px\">\n    Sent by CampusShield through n8n. Review and acknowledge alerts at\n    <a href=\"${esc(body.alerts_url)}\" style=\"color:#047857\">${esc(body.alerts_url)}</a>.\n  </p>\n</div>`;\n\nreturn [\n  {\n    json: {\n      alert_ids: alerts.map((a) => a.id).filter((id) => id > 0),\n      test: !!body.test,\n      telegram_text: telegram,\n      email_subject: subject,\n      email_html: html,\n    },\n  },\n];\n"
      }
    },
    {
      "id": "7b2e9f10-3c4d-4e5f-8a9b-0c1d2e3f4006",
