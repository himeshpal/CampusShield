# Copy to .env and change the secrets before a real demo.

# --- Database ---
POSTGRES_USER=campusshield
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=campusshield

# --- Backend ---
JWT_SECRET=change-me-to-a-long-random-string
# Token n8n uses when it calls the backend (scheduled scans, delivery callbacks)
SERVICE_API_KEY=change-me-service-key
# Only these subnets may be scanned (scope guard, comma-separated CIDRs)
AUTHORIZED_SUBNETS=172.25.0.0/24
# First admin account, created on first start
ADMIN_EMAIL=admin@campusshield.local
ADMIN_PASSWORD=Admin@123
# Printed on the cover of the PDF audit report
INSTITUTION_NAME=Campus IT network

# --- n8n ---
N8N_WEBHOOK_URL=http://n8n:5678/webhook/campusshield-events
N8N_WEBHOOK_SECRET=change-me-webhook-secret
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key

# --- Alert delivery (n8n) ---
# Telegram: create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<token>/getUpdates. Leave empty to skip Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=it-security@campus.local
ALERT_EMAIL_FROM=campusshield@campus.local
# Default: the bundled Mailpit inbox (http://127.0.0.1:8025). For real email, e.g. Gmail:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER / SMTP_PASSWORD (app password)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Scheduled scan (n8n, cron in Asia/Kolkata): daily at 07:00 by default
SCAN_SCHEDULE_CRON=0 7 * * *
SCAN_SCHEDULE_PROFILE=standard
